# Loaded automatically from repository root; shell variables take precedence.
GROQ_API_KEY=
CROSSREF_ENABLED=true
OPENALEX_ENABLED=true
ARXIV_ENABLED=true
# v2.1 providers. Semantic Scholar works keyless (shared rate limit); a key raises the limit.
SEMANTIC_SCHOLAR_ENABLED=true
SEMANTIC_SCHOLAR_API_KEY=
# Unpaywall (open-access locations by DOI) requires a REAL contact e-mail in API_CONTACT_EMAIL; it is skipped
# automatically while the address ends in @example.com.
UNPAYWALL_ENABLED=true
# Europe PMC open-access JATS full text (biomedical literature).
EUROPEPMC_ENABLED=true
# Replace with your own email: used for the Crossref/OpenAlex polite pools and required by Unpaywall.
API_CONTACT_EMAIL=citeguard@example.com
CROSSREF_TIMEOUT_SECONDS=3
# Timeout for one metadata-provider request during identification.
PROVIDER_TIMEOUT_SECONDS=10
# Successful identifications are cached in data/cache/identification for this many days (0 disables).
IDENTIFICATION_CACHE_DAYS=7
GROQ_TIMEOUT_SECONDS=5
CITEGUARD_MODE=neural
# Opt in for first-time model downloads. Default uses local cached models only.
CITEGUARD_ALLOW_DOWNLOAD=0

# Optional: raises OpenAlex limits; empty uses keyless access.
OPENALEX_API_KEY=
SOURCE_TIMEOUT_SECONDS=15
SOURCE_MAX_BYTES=26214400
# References resolved in parallel (1-8).
SOURCE_CONCURRENCY=4

# Shared by scripts/prepare_models.py AND the server. A mismatch shows up as WEIGHTS_NOT_CACHED.
# Leave empty to use the default HuggingFace cache (HF_HOME).
MODEL_CACHE_DIR=
# Log model readiness at server start (non-blocking).
CITEGUARD_WARMUP=true
# Retrieval bounds. The per-reference deadline caps the WORK for one reference (retries included); the clock starts
# when the reference gets a concurrency slot, never while it is queued behind other references.
SOURCE_MAX_RETRIES=2
SOURCE_BACKOFF_SECONDS=1.0
SOURCE_RETRY_AFTER_CAP_SECONDS=20
SOURCE_REFERENCE_DEADLINE_SECONDS=90
# Ceiling for one full-text location (redirects + retries) and the number of locations tried per reference.
SOURCE_URL_BUDGET_SECONDS=40
SOURCE_MAX_LOCATIONS=6
# OCR fallback for image-only PDFs: auto uses an installed engine (pip install rapidocr_onnxruntime), off disables.
OCR_MODE=auto
OCR_MAX_PAGES=30
